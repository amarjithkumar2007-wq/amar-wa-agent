{
  "name": "Amar WhatsApp Agent",
  "nodes": [
    {
      "parameters": {"path": "whatsapp", "responseMode": "responseNode", "options": {}},
      "id": "a1", "name": "Meta Verify (GET)", "type": "n8n-nodes-base.webhook", "typeVersion": 2,
      "position": [0, 0], "webhookId": "wa-verify"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.query['hub.verify_token'] === $env.VERIFY_TOKEN ? $json.query['hub.challenge'] : 'forbidden' }}",
        "options": {}
      },
      "id": "a2", "name": "Return Challenge", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.1,
      "position": [240, 0]
    },
    {
      "parameters": {"httpMethod": "POST", "path": "whatsapp", "options": {}},
      "id": "b1", "name": "WhatsApp Message (POST)", "type": "n8n-nodes-base.webhook", "typeVersion": 2,
      "position": [0, 300], "webhookId": "wa-message"
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "typeValidation": "loose"},
          "combinator": "and",
          "conditions": [
            {"id": "c1", "leftValue": "={{ $json.body.entry[0].changes[0].value.messages[0].type }}", "rightValue": "text", "operator": {"type": "string", "operation": "equals"}},
            {"id": "c2", "leftValue": "={{ $json.body.entry[0].changes[0].value.messages[0].from }}", "rightValue": "={{ $env.ALLOWED_NUMBER }}", "operator": {"type": "string", "operation": "equals"}}
          ]
        },
        "options": {}
      },
      "id": "b2", "name": "Text from Amar?", "type": "n8n-nodes-base.if", "typeVersion": 2.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.entry[0].changes[0].value.messages[0].text.body }}",
        "options": {
          "systemMessage": "You are Amar's personal WhatsApp assistant. Amar is a B.Tech AI/ML student in Hyderabad. Reply in short, clear Hinglish like WhatsApp chat. Help with questions, studying, coding (Python, Java, JS) and with tracking internships, hackathons and scholarships (deadlines, what to do next). Never claim you did something you cannot do."
        }
      },
      "id": "b3", "name": "AI Agent", "type": "@n8n/n8n-nodes-langchain.agent", "typeVersion": 1.7,
      "position": [500, 280]
    },
    {
      "parameters": {"modelName": "models/gemini-2.0-flash", "options": {}},
      "id": "b4", "name": "Gemini Chat Model", "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini", "typeVersion": 1,
      "position": [440, 520],
      "credentials": {"googlePalmApi": {"id": "SET_ME", "name": "Google Gemini(PaLM) Api account"}}
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('WhatsApp Message (POST)').item.json.body.entry[0].changes[0].value.messages[0].from }}",
        "contextWindowLength": 12
      },
      "id": "b5", "name": "Chat Memory", "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow", "typeVersion": 1.3,
      "position": [620, 520]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $env.PHONE_NUMBER_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Authorization", "value": "=Bearer {{ $env.WHATSAPP_TOKEN }}"}]},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $('WhatsApp Message (POST)').item.json.body.entry[0].changes[0].value.messages[0].from, type: 'text', text: { body: $json.output } }) }}",
        "options": {}
      },
      "id": "b6", "name": "Send WhatsApp Reply", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2,
      "position": [800, 280]
    }
  ],
  "connections": {
    "Meta Verify (GET)": {"main": [[{"node": "Return Challenge", "type": "main", "index": 0}]]},
    "WhatsApp Message (POST)": {"main": [[{"node": "Text from Amar?", "type": "main", "index": 0}]]},
    "Text from Amar?": {"main": [[{"node": "AI Agent", "type": "main", "index": 0}], []]},
    "AI Agent": {"main": [[{"node": "Send WhatsApp Reply", "type": "main", "index": 0}]]},
    "Gemini Chat Model": {"ai_languageModel": [[{"node": "AI Agent", "type": "ai_languageModel", "index": 0}]]},
    "Chat Memory": {"ai_memory": [[{"node": "AI Agent", "type": "ai_memory", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1"}
}
